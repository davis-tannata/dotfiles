# === Editor & Environment ===
export EDITOR="nvim"
export VISUAL="nvim"

# === Consolidated PATH ===
export PATH="$HOME/.local/bin:$PATH"
export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/development/flutter/bin:$PATH"
export PATH="$HOME/.gem/bin:$PATH"
export PATH="$HOME/.pub-cache/bin:$PATH"
export PATH="$HOME/.fvm_flutter/bin:$PATH"
export PATH="$HOME/.local/scripts:$PATH"
export PATH="$HOME/.rvm/bin:$PATH"

# === NVM ===
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && \. "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/etc/bash_completion.d/nvm" ]] && \. "$NVM_DIR/etc/bash_completion.d/nvm"

# === SDKMAN (must be after PATH setup) ===
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"

# === Pyenv ===
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

# === Optional completions ===
[[ -f "$HOME/.dart-cli-completion/zsh-config.zsh" ]] && source "$HOME/.dart-cli-completion/zsh-config.zsh"

# === Aliases ===
alias flutter="fvm flutter"
alias dart="fvm dart"

# === Local environment file ===
[[ -f "$HOME/.local/bin/env" ]] && source "$HOME/.local/bin/env"

# === Keybindings ===
bindkey -s '^f' 'tmux-sessionizer\n'

# === TMUX window renaming ===
if [[ -n "$TMUX" ]]; then
  autoload -Uz add-zsh-hook
  _tmux_rename_window_preexec() { tmux rename-window -- "${1:0:20}" }
  add-zsh-hook preexec _tmux_rename_window_preexec
fi
