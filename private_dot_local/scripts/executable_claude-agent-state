#!/usr/bin/env bash
# Records the current state of a Claude Code agent for the tmux dashboard.
# Called from Claude Code hooks; reads the hook JSON payload on stdin.
#
#   claude-agent-state working   # PreToolUse / PostToolUse / UserPromptSubmit
#   claude-agent-state waiting   # Notification (needs your input)
#   claude-agent-state done      # Stop / StopFailure (finished a turn)
#   claude-agent-state idle      # SessionStart
#   claude-agent-state end       # SessionEnd (remove the file)
#
# State file: <state>\t<action>\t<epoch>\t<label>\t<window_id>\t<window_index>

state="$1"
orig="$1"
dir="/tmp/claude-agents"
mkdir -p "$dir"

payload=$(cat 2>/dev/null)
cwd=$(printf '%s' "$payload" | jq -r '.cwd // empty' 2>/dev/null)

# Resolve the tmux pane this agent runs in. Claude Code does not always pass
# TMUX_PANE to hook subprocesses (forked/spawned sessions), so if it's missing
# we walk up the process tree to the claude process, which keeps it in its env.
pane="$TMUX_PANE"
if [ -z "$pane" ]; then
  pid=$PPID; depth=0
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] && [ "$depth" -lt 12 ]; do
    tp=$(ps eww -p "$pid" -o command= 2>/dev/null | tr ' ' '\n' | grep -m1 '^TMUX_PANE=' | cut -d= -f2)
    if [ -n "$tp" ]; then pane="$tp"; break; fi
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
    depth=$((depth + 1))
  done
fi

winid=""; winidx=""; tsess=""
if [ -n "$pane" ]; then
  tsess=$(tmux display-message -pt "$pane" '#S' 2>/dev/null)
  winid=$(tmux display-message -pt "$pane" '#{window_id}' 2>/dev/null)
  winidx=$(tmux display-message -pt "$pane" '#{window_index}' 2>/dev/null)
fi

# Key by window id when known (unique per claude window, so several agents in
# one tmux session don't overwrite each other); else by a STABLE base (project
# or tmux session) — not the title, which changes as the conversation evolves.
if [ -n "$winid" ]; then
  file="$dir/win-${winid#@}.state"
else
  kb="$tsess"; [ -z "$kb" ] && kb="${cwd##*/}"; [ -z "$kb" ] && kb="agent"
  file="$dir/$(printf '%s' "$kb" | tr -c 'A-Za-z0-9._-' '_').state"
fi

# Display label: the first real thing you typed this session (like the summary
# `claude --resume` shows), else the tmux session / project dir name. We skip
# slash-command / caveat / tool-result noise (anything starting with '<'). The
# first prompt never changes, so on frequent tool-use "working" pings we just
# reuse the label already stored instead of re-reading the transcript.
sess=""
if [ "$state" = "working" ] && [ -f "$file" ]; then
  sess=$(cut -f4 "$file" 2>/dev/null | head -1)
fi
if [ -z "$sess" ]; then
  tp=$(printf '%s' "$payload" | jq -r '.transcript_path // empty' 2>/dev/null)
  if [ -n "$tp" ] && [ -f "$tp" ]; then
    sess=$(jq -r 'select(.type=="user") | (.message.content
             | if type=="string" then . elif type=="array" then (map(select(.type=="text").text)|join(" ")) else "" end)
             | gsub("\\s+";" ") | sub("^ +";"") | sub(" +$";"")' "$tp" 2>/dev/null \
           | grep -vE '^$' | grep -vE '^<' | grep -viE '^Caveat:' | head -1)
  fi
fi
[ -z "$sess" ] && sess="$tsess"
[ -z "$sess" ] && [ -n "$cwd" ] && sess="${cwd##*/}"
[ -z "$sess" ] && sess="agent"

# A turn ending in a pane you're NOT looking at is really "waiting on you".
if [ "$state" = "done" ] && [ -n "$winid" ]; then
  vis=$(tmux display-message -pt "$pane" '#{?#{&&:#{session_attached},#{&&:#{window_active},#{pane_active}}},1,0}' 2>/dev/null)
  [ "$vis" != "1" ] && state="waiting"
fi

# Tag the window so the window list colors it, then force an immediate redraw.
if [ -n "$winid" ]; then
  if [ "$state" = "end" ]; then
    tmux set-window-option -t "$winid" -u @claude_state 2>/dev/null || true
  else
    tmux set-window-option -t "$winid" @claude_state "$state" 2>/dev/null || true
  fi
  tmux refresh-client -S 2>/dev/null || true
fi

if [ "$state" = "end" ]; then
  rm -f "$file"
  exit 0
fi

action=""
case "$state" in
  working)
    tool=$(printf '%s' "$payload" | jq -r '.tool_name // empty' 2>/dev/null)
    case "$tool" in
      Edit|Write|MultiEdit|NotebookEdit)
        f=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // .tool_input.notebook_path // empty' 2>/dev/null)
        action="editing ${f##*/}" ;;
      Read)
        f=$(printf '%s' "$payload" | jq -r '.tool_input.file_path // empty' 2>/dev/null)
        action="reading ${f##*/}" ;;
      Bash)
        c=$(printf '%s' "$payload" | jq -r '.tool_input.command // empty' 2>/dev/null | tr '\n' ' ')
        action="\$ ${c:0:28}" ;;
      Grep|Glob)          action="searching" ;;
      Task)               action="subagent" ;;
      WebFetch|WebSearch) action="web" ;;
      "")                 action="thinking" ;;
      *)                  action="$tool" ;;
    esac ;;
  waiting)
    if [ "$orig" = "done" ]; then
      action="your turn"
    else
      action=$(printf '%s' "$payload" | jq -r '.message // "needs input"' 2>/dev/null)
    fi ;;
  done) action="done" ;;
  idle) action="ready" ;;
esac

printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$state" "$action" "$(date +%s)" "$sess" "$winid" "$winidx" > "$file"
